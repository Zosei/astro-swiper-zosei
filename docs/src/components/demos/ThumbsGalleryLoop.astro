import { Swiper, Wrapper, Slide, ButtonPrev, ButtonNext } from 'astro-swiper-zosei';
import { Image } from 'astro:assets';
import { getSlides } from '../../data/slides';

const slides = getSlides(6);
---

<div class="w-full space-y-3">
  <!-- Main Carousel -->
  <Swiper
    spaceBetween={10}
    loop={true}
    navigation={true}
    thumbs="#myswiper-thumbs-gallery-loop-thumbnail"
    class="w-full aspect-video rounded-2xl overflow-hidden shadow-2xl"
  >
    <Wrapper>
      {slides.map((slide) => (
        <Slide class="rounded-2xl overflow-hidden">
          <Image src={slide.img} alt={slide.title} class="w-full h-full object-cover" />
        </Slide>
      ))}
    </Wrapper>
    <ButtonPrev variant="glass" />
    <ButtonNext variant="glass" />
  </Swiper>

  <!-- Thumbnail Track -->
  <Swiper
    id="myswiper-thumbs-gallery-loop-thumbnail"
    spaceBetween={10}
    slidesPerView={4}
    freeMode={true}
    watchSlidesProgress={true}
    loop={true}
    class="w-full"
  >
    <Wrapper>
      {slides.map((slide) => (
        <Slide class="rounded-xl overflow-hidden aspect-video cursor-pointer opacity-50 hover:opacity-100 transition-opacity">
          <Image src={slide.img} alt={slide.title} class="w-full h-full object-cover" />
        </Slide>
      ))}
    </Wrapper>
  </Swiper>
</div>
