import { Swiper, Wrapper, Slide, Pagination } from 'astro-swiper-zosei';
import { Image } from 'astro:assets';
import { getSlides } from '../../data/slides';

const slides = getSlides(7);
---

<Swiper
  effect="coverflow"
  grabCursor={true}
  centeredSlides={true}
  slidesPerView="auto"
  coverflowEffect={{
    rotate: 50,
    stretch: 0,
    depth: 100,
    modifier: 1,
    slideShadows: true,
  }}
  pagination={{ clickable: true }}
  class="w-full py-6"
>
  <Wrapper>
    {slides.map((slide) => (
      <Slide class="!w-64 sm:!w-80 aspect-video rounded-2xl overflow-hidden shadow-2xl">
        <Image src={slide.img} alt={slide.title} class="w-full h-full object-cover" />
      </Slide>
    ))}
  </Wrapper>
  <Pagination variant="pills" color="purple" />
</Swiper>
