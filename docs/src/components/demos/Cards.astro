import { Swiper, Wrapper, Slide } from 'astro-swiper-zosei';
import { Image } from 'astro:assets';
import { getSlides } from '../../data/slides';

const slides = getSlides(5);
---

<Swiper
  effect="cards"
  grabCursor={true}
  class="w-64 sm:w-72 h-96 mx-auto"
>
  <Wrapper>
    {slides.map((slide, i) => (
      <Slide class="rounded-3xl overflow-hidden shadow-2xl relative group">
        <Image src={slide.img} alt={slide.title} class="w-full h-full object-cover" />
        <div class="absolute inset-x-0 bottom-0 p-5 bg-gradient-to-t from-black/90 via-black/40 to-transparent flex flex-col justify-end">
          <span class="text-[10px] font-mono text-indigo-400 font-bold uppercase tracking-wider">Tarjeta #{i + 1}</span>
          <h3 class="text-lg font-bold text-white mt-0.5">{slide.title}</h3>
          <p class="text-xs text-slate-300 mt-1">{slide.subtitle}</p>
        </div>
      </Slide>
    ))}
  </Wrapper>
</Swiper>
