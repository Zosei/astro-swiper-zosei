import { Swiper, Wrapper, Slide, ButtonPrev, ButtonNext, Pagination } from 'astro-swiper-zosei';
import { Image } from 'astro:assets';
import { getSlides } from '../../data/slides';

const slides = getSlides(5);
---

<Swiper
  autoHeight={true}
  spaceBetween={20}
  navigation={true}
  pagination={{ clickable: true }}
  class="w-full rounded-2xl overflow-hidden shadow-xl"
>
  <Wrapper>
    {slides.map((slide, i) => (
      <Slide class="rounded-2xl overflow-hidden group">
        <div class={`w-full ${i === 1 ? 'h-64' : i === 2 ? 'h-80' : 'h-48'} transition-all duration-300 relative`}>
          <Image src={slide.img} alt={slide.title} class="w-full h-full object-cover" />
          <div class="absolute bottom-3 left-3 px-3 py-1 rounded-lg bg-black/60 backdrop-blur-sm text-xs font-mono text-white">
            Slide #{i + 1} (Altura: {i === 1 ? '256px' : i === 2 ? '320px' : '192px'})
          </div>
        </div>
      </Slide>
    ))}
  </Wrapper>
  <ButtonPrev variant="glass" />
  <ButtonNext variant="glass" />
  <Pagination variant="pills" color="indigo" />
</Swiper>
