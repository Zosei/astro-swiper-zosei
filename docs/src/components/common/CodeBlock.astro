interface Props {
  code: string;
  lang?: string;
  title?: string;
  badge?: string;
}

const {
  code,
  lang = 'astro',
  title = 'Código de Ejemplo',
  badge = 'Astro Swiper'
} = Astro.props;

const blockId = `code-block-${Math.random().toString(36).substring(2, 9)}`;
---

<div class="rounded-2xl bg-[#080b11] border border-white/10 p-5 font-mono text-xs shadow-2xl relative group">
  <!-- Header -->
  <div class="flex items-center justify-between text-slate-400 mb-3 border-b border-white/10 pb-3">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-indigo-500/80"></span>
      <span class="font-bold text-white tracking-wide">{title}</span>
    </div>
    <div class="flex items-center gap-3">
      <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-300 border border-indigo-500/20">{badge}</span>
      <button
        type="button"
        data-copy-button
        data-target={blockId}
        class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white/5 hover:bg-white/10 active:bg-indigo-600/30 text-slate-300 hover:text-white border border-white/10 hover:border-indigo-500/40 transition-all text-xs font-sans cursor-pointer focus:outline-none focus:ring-2 focus:ring-indigo-500/50"
        title="Copiar código"
      >
        <svg class="w-3.5 h-3.5 text-indigo-400 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <span class="copy-text text-[11px] font-medium">Copiar</span>
      </button>
    </div>
  </div>

  <!-- Code content -->
  <pre class="text-indigo-200 overflow-x-auto leading-relaxed p-2 scrollbar-thin"><code id={blockId}>{code.trim()}</code></pre>
</div>

<script>
  function setupCopyButtons() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-copy-button]');
    buttons.forEach((btn) => {
      if (btn.dataset.initialized) return;
      btn.dataset.initialized = 'true';

      btn.addEventListener('click', async () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const codeElement = document.getElementById(targetId);
        if (!codeElement) return;

        const textToCopy = codeElement.innerText || codeElement.textContent || '';
        let success = false;
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(textToCopy);
            success = true;
          }
        } catch (_) {}

        if (!success) {
          const textArea = document.createElement('textarea');
          textArea.value = textToCopy;
          textArea.style.position = 'fixed';
          textArea.style.left = '-9999px';
          document.body.appendChild(textArea);
          textArea.select();
          try {
            document.execCommand('copy');
            success = true;
          } catch (_) {}
          document.body.removeChild(textArea);
        }

        const copyText = btn.querySelector('.copy-text');
        const originalText = copyText?.textContent || 'Copiar';

        if (copyText) {
          copyText.textContent = '¡Copiado!';
          btn.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40');
          setTimeout(() => {
            copyText.textContent = originalText;
            btn.classList.remove('bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40');
          }, 2000);
        }
      });
    });
  }

  // Setup on initial load and Astro page swaps
  setupCopyButtons();
  document.addEventListener('astro:page-load', setupCopyButtons);
</script>
