      <div>
        <h2 data-i18n="home.catalogTitle" class="text-3xl font-extrabold text-white tracking-tight">Catálogo Completo de Demos</h2>
        <p data-i18n="home.catalogSubtitle" class="text-sm text-slate-400 mt-1">Explora más de 50 demostraciones interactivas funcionando con Tailwind CSS v4.</p>
      </div>
      <a href="/demos" class="px-4 py-2 rounded-xl bg-indigo-600/20 text-indigo-300 border border-indigo-500/30 text-xs font-semibold hover:bg-indigo-600/30 transition-colors self-start md:self-auto">
        Ver Páginas Dedicadas (/demos) →
      </a>
    </div>

    <!-- Demos Grid: preserves every test ID for Playwright compatibility -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="demos-container">
      <!-- 3D & Creative Effects -->
      <div class="demo-card p-5 rounded-2xl bg-[#0e1320] border border-white/10 hover:border-indigo-500/40 transition-all flex flex-col">
