import Layout from '../layouts/Layout.astro';
import { demosRegistry, getDemoBySlug } from '../data/demosRegistry';
import { Swiper, Wrapper, Slide, ButtonPrev, ButtonNext, Pagination, Scrollbar } from 'astro-swiper-zosei';

// Swiper Demo Components (Organizados en components/demos sin prefijo Demo)
import Autoplay from '../components/demos/Autoplay.astro';
import Autoheight from '../components/demos/Autoheight.astro';
import AutoplayProgress from '../components/demos/AutoplayProgress.astro';
import Centered from '../components/demos/Centered.astro';
import CenteredAuto from '../components/demos/CenteredAuto.astro';
import ChangeDirection from '../components/demos/ChangeDirection.astro';
import CssMode from '../components/demos/CssMode.astro';
import CustomPlugin from '../components/demos/CustomPlugin.astro';
import Default from '../components/demos/Default.astro';
import Cards from '../components/demos/Cards.astro';
import CoverFlow from '../components/demos/CoverFlow.astro';
import Creative from '../components/demos/Creative.astro';
import Cube from '../components/demos/Cube.astro';
import Fade from '../components/demos/Fade.astro';
import Flip from '../components/demos/Flip.astro';
import FreeMode from '../components/demos/FreeMode.astro';
import GrabCursor from '../components/demos/GrabCursor.astro';
import Grid from '../components/demos/Grid.astro';
import HashNavigation from '../components/demos/HashNavigation.astro';
import History from '../components/demos/History.astro';
import InfiniteLoop from '../components/demos/InfiniteLoop.astro';
import KeyboardControl from '../components/demos/KeyboardControl.astro';
import LazyLoadImages from '../components/demos/LazyLoadImages.astro';
import Manipulation from '../components/demos/Manipulation.astro';
import MousewheelControl from '../components/demos/MousewheelControl.astro';
import MultipleSwipers from '../components/demos/MultipleSwipers.astro';
import Navigation from '../components/demos/Navigation.astro';
import Nested from '../components/demos/Nested.astro';
import PaginationDemo from '../components/demos/Pagination.astro';
import PaginationCustom from '../components/demos/PaginationCustom.astro';
import PaginationDynamic from '../components/demos/PaginationDynamic.astro';
import PaginationFraction from '../components/demos/PaginationFraction.astro';
import PaginationProgress from '../components/demos/PaginationProgress.astro';
import Parallax from '../components/demos/Parallax.astro';
import RatioBreakpoints from '../components/demos/RatioBreakpoints.astro';
import ResponsiveBreakpoints from '../components/demos/ResponsiveBreakpoints.astro';
import Rewind from '../components/demos/Rewind.astro';
import Rtl from '../components/demos/Rtl.astro';
import ScrollContainer from '../components/demos/ScrollContainer.astro';
import ScrollbarDemo from '../components/demos/Scrollbar.astro';
import SlideableMenu from '../components/demos/SlideableMenu.astro';
import SlidesPerGroupSkip from '../components/demos/SlidesPerGroupSkip.astro';
import SlidesPerView from '../components/demos/SlidesPerView.astro';
import SlidesPerViewAuto from '../components/demos/SlidesPerViewAuto.astro';
import SpaceBetween from '../components/demos/SpaceBetween.astro';
import ThumbsGallery from '../components/demos/ThumbsGallery.astro';
import ThumbsGalleryLoop from '../components/demos/ThumbsGalleryLoop.astro';
import Vertical from '../components/demos/Vertical.astro';
import VirtualSlides from '../components/demos/VirtualSlides.astro';
import WatchSlidesVisibility from '../components/demos/WatchSlidesVisibility.astro';
import Zoom from '../components/demos/Zoom.astro';
import IndexExample from '../components/demos/IndexExample.astro';
import Thumbnail from '../components/demos/Thumbnail.astro';
---

<Layout>
  <!-- Hero Section -->
  <section id="showcase" class="relative pt-12 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="text-center space-y-6 max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-xs font-semibold text-indigo-300">
        <span class="flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span data-i18n="home.badge">Astro 5+ & 7+ • Swiper v14+ • Tailwind v4</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
        <span data-i18n="home.title">Carruseles Modernos para Astro</span> <br />
        <span class="bg-gradient-to-r from-indigo-400 via-purple-400 to-cyan-400 bg-clip-text text-transparent">
          Cero JS manual. Puro Tailwind v4.
        </span>
      </h1>

      <p data-i18n="home.subtitle" class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
        El componente Swiper definitivo para Astro. Pasa todas las configuraciones directamente como props tipadas, con Intersection Observer inteligente, sincronización de miniaturas y diseño moderno con Tailwind v4.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
        <div class="flex items-center bg-[#101726] border border-white/10 rounded-xl px-4 py-2.5 shadow-xl text-xs sm:text-sm font-mono text-slate-300">
          <span class="text-indigo-400 mr-2 font-bold">$</span>
          <span>pnpm add astro-swiper-zosei swiper</span>
        </div>
        <a
          href="/docs"
          data-i18n="home.viewDocs"
          class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs sm:text-sm font-semibold shadow-lg shadow-indigo-500/25 transition-all hover:scale-105"
        >
          Guía de Props →
        </a>
        <a
          href="/demos"
          data-i18n="home.viewDemos"
          class="px-5 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 text-white text-xs sm:text-sm font-semibold border border-white/10 transition-all"
        >
          Explorar 50+ Demos →
        </a>
      </div>
    </div>

    <!-- Live Featured Cards Showcase -->
    <div class="mt-14 max-w-4xl mx-auto p-6 rounded-3xl bg-[#0d121f]/80 border border-white/10 shadow-2xl backdrop-blur-xl">
      <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-6">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-rose-500"></div>
          <div class="w-3 h-3 rounded-full bg-amber-500"></div>
          <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
          <span data-i18n="home.featuredTitle" class="ml-2 text-xs font-mono text-slate-300 font-semibold">Demo Destacada: 3D Cards Effect</span>
        </div>
        <div class="flex items-center gap-3">
          <button
            type="button"
            data-code={getDemoBySlug('cards')?.codeSkeleton || ''}
            class="quick-copy-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-indigo-600/30 hover:bg-indigo-600/50 text-indigo-300 hover:text-white text-xs font-semibold border border-indigo-500/40 transition-all active:scale-95 cursor-pointer shadow-sm"
            title="Copiar esqueleto de código Astro"
          >
            <svg class="w-3.5 h-3.5 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
            </svg>
            <span class="btn-text" data-i18n="home.copyCode">Copiar Código</span>
          </button>
          <span data-i18n="home.declarativeBadge" class="text-xs px-2.5 py-1 rounded-full bg-indigo-500/20 text-indigo-300 font-mono">100% Declarativo</span>
        </div>
      </div>
      <div class="w-full flex justify-center">
        <div class="w-full max-w-md">
          <Cards />
        </div>
      </div>
    </div>
  </section>

  <!-- Complete 50+ Demos Catalog (Visibles y Funcionales) -->
