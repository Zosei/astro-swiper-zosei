<script>
  function setupIndexCopyButtons() {
    document.querySelectorAll('.quick-copy-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const code = btn.getAttribute('data-code') || '';
        const textSpan = btn.querySelector('.btn-text');
        try {
          await navigator.clipboard.writeText(code);
          if (textSpan) textSpan.textContent = '¡Copiado!';
          btn.classList.add('!bg-emerald-600/30', '!text-emerald-300', '!border-emerald-500/50');
          setTimeout(() => {
            if (textSpan) textSpan.textContent = 'Copiar Código';
            btn.classList.remove('!bg-emerald-600/30', '!text-emerald-300', '!border-emerald-500/50');
          }, 2000);
        } catch (err) {
          console.error('Error al copiar:', err);
        }
      });
    });
  }

  setupIndexCopyButtons();
  document.addEventListener('astro:page-load', setupIndexCopyButtons);
</script>
