import Layout from '../layouts/Layout.astro';
import CodeBlock from '../components/common/CodeBlock.astro';

const swiperProps = [
  { name: 'preset', type: "'hero' | 'cards' | 'marquee' | 'testimonials' | 'gallery'", default: 'undefined', desc: '⚡ Preset predeterminado de 1 sola línea optimizado para producción.' },
  { name: 'direction', type: "'horizontal' | 'vertical'", default: "'horizontal'", desc: 'Dirección del desplazamiento de los slides.' },
  { name: 'slidesPerView', type: "number | 'auto'", default: '1', desc: 'Cantidad de diapositivas visibles simultáneamente en el viewport.' },
  { name: 'spaceBetween', type: 'number', default: '0', desc: 'Espacio en píxeles de separación (gap) entre cada diapositiva.' },
  { name: 'loop', type: 'boolean', default: 'false', desc: 'Activa el ciclo infinito continuo donde el último slide enlaza con el primero.' },
  { name: 'rewind', type: 'boolean', default: 'false', desc: 'Regresa al primer slide al llegar al final del carrusel.' },
  { name: 'speed', type: 'number', default: '300', desc: 'Duración de la animación de transición en milisegundos.' },
  { name: 'effect', type: "'slide' | 'fade' | 'cube' | 'coverflow' | 'flip' | 'cards' | 'creative'", default: "'slide'", desc: 'Efecto de transición visual tridimensional o plano.' },
  { name: 'autoplay', type: 'boolean | AutoplayOptions', default: 'false', desc: 'Configura reproducción automática con delay, pauseOnMouseEnter, disableOnInteraction, etc.' },
  { name: 'pauseWhenHidden', type: 'boolean', default: 'false', desc: 'Pausa el autoplay con Intersection Observer automáticamente cuando el carrusel no está visible en pantalla.' },
  { name: 'lazyInit', type: 'boolean', default: 'false', desc: 'Inicializa la instancia de Swiper solo cuando el carrusel entra al viewport del navegador.' },
  { name: 'navigation', type: 'boolean | NavigationOptions', default: 'false', desc: 'Habilita botones anterior/siguiente de navegación.' },
  { name: 'pagination', type: 'boolean | PaginationOptions', default: 'false', desc: 'Habilita paginación (bullets clicables, números de fracción o barra de progreso).' },
  { name: 'scrollbar', type: 'boolean | ScrollbarOptions', default: 'false', desc: 'Habilita barra de desplazamiento interactiva y arrastrable.' },
  { name: 'breakpoints', type: 'Record<number, SwiperOptions>', default: 'undefined', desc: 'Configuración responsiva adaptativa según el ancho de pantalla en píxeles.' },
  { name: 'grabCursor', type: 'boolean', default: 'false', desc: 'Muestra cursor de agarre interactivo (grab / grabbing) al pasar el ratón.' },
  { name: 'centeredSlides', type: 'boolean', default: 'false', desc: 'Centra el slide activo en el medio del contenedor.' },
  { name: 'autoHeight', type: 'boolean', default: 'false', desc: 'Ajusta la altura del carrusel dinámicamente según la altura del slide activo.' },
  { name: 'freeMode', type: 'boolean | FreeModeOptions', default: 'false', desc: 'Permite arrastre libre e inercial sin ajuste forzado a bordes de slides.' },
  { name: 'keyboard', type: 'boolean | KeyboardOptions', default: 'false', desc: 'Habilita navegación mediante las teclas de flecha del teclado físico.' },
  { name: 'mousewheel', type: 'boolean | MousewheelOptions', default: 'false', desc: 'Habilita navegación mediante la rueda de desplazamiento del ratón o touchpad.' },
  { name: 'zoom', type: 'boolean | ZoomOptions', default: 'false', desc: 'Habilita zoom interactivo mediante doble clic o gesto táctil de pellizco.' },
  { name: 'grid', type: '{ rows: number, fill?: "row" | "column" }', default: 'undefined', desc: 'Disposición en cuadrícula matricial multi-fila 2D.' },
  { name: 'thumbs', type: 'string | { swiper?: string | Swiper }', default: 'undefined', desc: 'Selector del carrusel de miniaturas sincronizado (ej: "#my-thumbs" o ".my-thumbs").' },
  { name: 'options', type: 'AstroSwiperOptions', default: '{}', desc: 'Objeto de configuración de bajo nivel de Swiper.js para casos avanzados.' },
  { name: 'addDefaultClass', type: 'boolean', default: 'true', desc: 'Añade automáticamente la clase CSS requerida ".swiper" al contenedor principal.' },
  { name: 'useCustomElement', type: 'boolean', default: 'true', desc: 'Utiliza el custom element web component <astro-swiper-zosei>.' },
];

const subcomponents = [
  {
    name: 'Sw / Sw.Container / Swiper',
    alias: '<Sw>',
    desc: 'Contenedor principal con gestión de ciclo de vida, soporte de Presets, View Transitions y configuración declarativa.',
    props: 'preset, direction, slidesPerView, spaceBetween, loop, effect, autoplay, navigation, pagination, scrollbar, ...',
  },
  {
    name: 'Sw.Wrap / Sw.Wrapper / Wrapper',
    alias: '<Sw.Wrap>',
    desc: 'Contenedor flex obligatorio de los slides con soporte de fallback Zero-JS con CSS Scroll-Snap.',
    props: 'class, id, ...HTMLAttributes<"div">',
  },
  {
    name: 'Sw.Slide / Sw.S / Slide',
    alias: '<Sw.Slide>',
    desc: 'Diapositiva individual para alojar imágenes, tarjetas, contenido HTML o componentes Astro.',
    props: 'class, lazy, ...HTMLAttributes<"div">',
  },
  {
    name: 'Sw.Prev / Sw.Next',
    alias: '<Sw.Prev /> / <Sw.Next />',
    desc: 'Botones modernos de navegación con iconos SVG nítidos y variantes de Tailwind v4.',
    props: 'variant ("glass" | "solid" | "minimal" | "floating"), size ("sm" | "md" | "lg"), color, rounded',
  },
  {
    name: 'Sw.Pag / Sw.Pagination',
    alias: '<Sw.Pag />',
    desc: 'Indicador de paginación por bullets, números de fracción o barra de progreso.',
    props: 'variant ("pills" | "dots" | "dynamic" | "fraction" | "progressbar"), color ("indigo" | "purple" | "cyan" | "white")',
  },
  {
    name: 'Sw.Scroll / Sw.Scrollbar',
    alias: '<Sw.Scroll />',
    desc: 'Barra de desplazamiento arrastrable personalizada con soporte gestual.',
    props: 'color, class',
  },
  {
    name: 'Sw.Toggle / Sw.AutoplayToggle',
    alias: '<Sw.Toggle />',
    desc: 'Control interactivo de Play / Pausa con estado animado SVG para carruseles con autoplay.',
    props: 'variant, size, position ("top-right" | "bottom-right" | "top-left" | "bottom-left" | "none")',
  },
  {
    name: 'Sw.Count / Sw.Counter',
    alias: '<Sw.Count />',
    desc: 'Badge numérico en tiempo real del slide activo ("01 / 08").',
    props: 'padZero (true/false), separator (" / "), variant, size, position',
  },
  {
    name: 'Sw.Full / Sw.Fullscreen',
    alias: '<Sw.Full />',
    desc: 'Botón nativo para expandir el carrusel a pantalla completa.',
    props: 'variant, size, position',
  },
  {
    name: 'Sw.Lazy / Sw.LazyPreloader',
    alias: '<Sw.Lazy />',
    desc: 'Spinner SVG animado para carga diferida (lazy load) de imágenes.',
    props: 'color, class',
  },
];
---

<Layout title="Documentación de Props, Presets y API — Astro Swiper Zosei v0.15.0">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 py-12">
    <!-- Header -->
    <div class="space-y-4 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 text-indigo-300 text-xs font-bold border border-indigo-500/20 shadow-inner">
        <span data-i18n="docs.badge">📖 Referencia de TypeScript, Presets & API v0.15.0</span>
      </div>
      <h1 data-i18n="docs.title" class="text-4xl sm:text-5xl font-black text-white tracking-tight">
        Documentación de Parámetros y API
      </h1>
      <p data-i18n="docs.subtitle" class="text-slate-300 text-base sm:text-lg leading-relaxed">
        Configura carruseles completos en Astro pasando props directamente a <code class="text-indigo-400 font-mono font-bold bg-indigo-500/10 px-2 py-0.5 rounded">&lt;Sw /&gt;</code>, usando <code class="text-purple-400 font-mono font-bold bg-purple-500/10 px-2 py-0.5 rounded">preset="..."</code> o probándolos en el <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/playground`} class="text-cyan-400 underline font-semibold hover:text-cyan-300">Playground interactivo</a>.
      </p>
    </div>

    <!-- Playground Promo Banner -->
    <div class="rounded-3xl border border-indigo-500/30 bg-gradient-to-r from-indigo-900/40 via-purple-900/30 to-slate-900/60 p-6 sm:p-8 backdrop-blur-xl shadow-2xl flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-2 text-center sm:text-left">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-400">✨ Novedad v0.15.0</span>
        <h3 class="text-2xl font-black text-white">¿Prefieres construirlo visualmente?</h3>
        <p class="text-slate-300 text-sm max-w-xl">Usa nuestro constructor interactivo para ajustar efectos, velocidades, colores y generar código Astro en 1 clic.</p>
      </div>
      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/playground`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm transition-all shadow-xl hover:scale-105 active:scale-95 flex-shrink-0"
      >
        <span>Abrir Playground</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Instalación y Patrones de Importación -->
    <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8 backdrop-blur-xl shadow-2xl space-y-6">
      <h2 data-i18n="docs.quickInstall" class="text-xl font-bold text-white flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-indigo-400"></span>
        Instalación Oficial (Astro 5+ & 7+ Ready)
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-2">
          <span class="text-xs text-slate-400 font-mono">1. Integración automática con Astro CLI:</span>
          <div class="p-3.5 rounded-2xl bg-slate-950/80 border border-slate-800 font-mono text-xs text-indigo-300 flex items-center justify-between">
            <code>npx astro add astro-swiper-zosei</code>
          </div>
        </div>

        <div class="space-y-2">
          <span class="text-xs text-slate-400 font-mono">2. O con tu gestor de paquetes favorito:</span>
          <div class="p-3.5 rounded-2xl bg-slate-950/80 border border-slate-800 font-mono text-xs text-purple-300 flex items-center justify-between">
            <code>pnpm add astro-swiper-zosei swiper</code>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabla de Presets Listos -->
    <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8 backdrop-blur-xl shadow-2xl space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
            Sistema de Presets Listos para Producción (<code class="text-cyan-300 font-mono">preset="..."</code>)
          </h2>
          <p class="text-slate-400 text-sm mt-1">Configuraciones de 1 línea optimizadas para casos de uso comunes.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl bg-slate-950/60 border border-slate-800">
          <span class="text-xs font-mono font-bold text-indigo-400 uppercase">preset="hero"</span>
          <h4 class="text-white font-bold mt-1">Hero Banner</h4>
          <p class="text-slate-400 text-xs mt-2">Fade suave, autoplay con pausa al hover, loop infinito y controles glass.</p>
        </div>
        <div class="p-5 rounded-2xl bg-slate-950/60 border border-slate-800">
          <span class="text-xs font-mono font-bold text-purple-400 uppercase">preset="cards"</span>
          <h4 class="text-white font-bold mt-1">3D Cards</h4>
          <p class="text-slate-400 text-xs mt-2">Efecto de tarjetas tridimensionales apiladas con sombras y rotación suave.</p>
        </div>
        <div class="p-5 rounded-2xl bg-slate-950/60 border border-slate-800">
          <span class="text-xs font-mono font-bold text-cyan-400 uppercase">preset="marquee"</span>
          <h4 class="text-white font-bold mt-1">Logo Marquee</h4>
          <p class="text-slate-400 text-xs mt-2">Desplazamiento infinito continuo sin pausas para marcas y patrocinadores.</p>
        </div>
        <div class="p-5 rounded-2xl bg-slate-950/60 border border-slate-800">
          <span class="text-xs font-mono font-bold text-emerald-400 uppercase">preset="testimonials"</span>
          <h4 class="text-white font-bold mt-1">Testimonials</h4>
          <p class="text-slate-400 text-xs mt-2">Slides centrados y responsivos (1 a 3 columnas) con paginación dinámica.</p>
        </div>
        <div class="p-5 rounded-2xl bg-slate-950/60 border border-slate-800">
          <span class="text-xs font-mono font-bold text-rose-400 uppercase">preset="gallery"</span>
          <h4 class="text-white font-bold mt-1">Gallery Zoom</h4>
          <p class="text-slate-400 text-xs mt-2">Galería interactiva con soporte de zoom gestual y paginación por fracción.</p>
        </div>
      </div>
    </div>

    <!-- Tabla de Props -->
    <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8 backdrop-blur-xl shadow-2xl space-y-6">
      <div>
        <h2 data-i18n="docs.propsTableTitle" class="text-xl font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
          Parámetros del Componente &lt;Sw /&gt;
        </h2>
        <p data-i18n="docs.propsTableSubtitle" class="text-slate-400 text-sm mt-1">
          Todas las propiedades son tipadas e inferidas automáticamente por TypeScript.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-slate-800 text-slate-400 font-mono uppercase text-[11px]">
              <th class="py-3 px-4">Propiedad</th>
              <th class="py-3 px-4">Tipo TypeScript</th>
              <th class="py-3 px-4">Por Defecto</th>
              <th class="py-3 px-4">Descripción</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 text-slate-300">
            {swiperProps.map((prop) => (
              <tr class="hover:bg-slate-800/30 transition-colors">
                <td class="py-3.5 px-4 font-mono font-bold text-indigo-300">{prop.name}</td>
                <td class="py-3.5 px-4 font-mono text-purple-300 text-xs">{prop.type}</td>
                <td class="py-3.5 px-4 font-mono text-slate-400 text-xs">{prop.default}</td>
                <td class="py-3.5 px-4 leading-relaxed">{prop.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Subcomponentes y Micro-controles -->
    <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8 backdrop-blur-xl shadow-2xl space-y-6">
      <div>
        <h2 class="text-xl font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-purple-400"></span>
          Subcomponentes & Micro-Controles v0.15.0
        </h2>
        <p class="text-slate-400 text-sm mt-1">
          Componentes modulares estilizados con Tailwind CSS v4 para navegación, paginación, contadores y controles interactivos.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {subcomponents.map((sub) => (
          <div class="p-5 rounded-2xl bg-slate-950/60 border border-slate-800/80 space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-mono font-bold text-white text-sm">{sub.name}</span>
              <span class="text-xs px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-mono">{sub.alias}</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">{sub.desc}</p>
            <div class="text-[11px] font-mono text-slate-400 bg-slate-900/80 p-2 rounded-lg border border-slate-800">
              <span class="text-slate-500 font-semibold">Props: </span>{sub.props}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
