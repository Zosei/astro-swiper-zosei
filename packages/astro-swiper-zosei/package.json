{
  "name": "astro-swiper-zosei",
  "version": "0.15.0",
  "description": "Astro component for swiper, dedicated to slider / carousel / photo swiper / slide, including thumbnails",
  "type": "module",
  "main": "index.ts",
  "bin": {
    "astro-swiper-zosei": "./scripts/init.cjs"
  },
  "scripts": {
    "postinstall": "node ./scripts/init.cjs",
    "preversion": "pnpm run build && pnpm run test",
    "format": "biome format --write && prettier -w \"**/*.astro\"",
    "lint": "biome lint",
    "test": "pnpm run --filter docs test",
    "build": "pnpm run --filter docs build",
    "dev": "pnpm run --filter docs dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zosei/astro-swiper-zosei.git",
    "directory": "astro-swiper-zosei"
  },
  "author": "Zosei",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zosei/astro-swiper-zosei/issues"
  },
  "homepage": "https://zosei.github.io/astro-swiper-zosei/",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./integration": {
      "types": "./src/integration.ts",
      "default": "./src/integration.ts"
    },
    "./swiper": "./swiper.ts"
  },
  "files": [
    "index.ts",
    "swiper.ts",
    "src/**",
    "scripts/**",
    "AGENTS/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18",
    "npm": ">=9.6.5",
    "pnpm": ">=7.1.0"
  },
  "packageManager": "pnpm@11.17.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^26.3.0",
    "astro": "^7.2.6",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "swiper",
    "withastro",
    "astro-component",
    "image",
    "carousel",
    "swiper",
    "slider",
    "slideshow",
    "gallery",
    "lightweight",
    "touch",
    "responsive",
    "thumbnail"
  ],
  "dependencies": {
    "swiper": "^14.1.0"
  },
  "peerDependencies": {
    "astro": ">=5.0.0",
    "swiper": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "swiper": {
      "optional": true
    }
  }
}
