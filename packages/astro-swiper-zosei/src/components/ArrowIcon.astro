import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'svg'> {
  /** Dirección de la flecha ('next' apunta a la derecha, 'prev' rota 180° a la izquierda) */
  direction?: 'next' | 'prev';
  /** Tamaño del icono */
  size?: 'sm' | 'md' | 'lg';
}

const { direction = 'next', size = 'md', class: className = '', ...props } = Astro.props;

const sizeClasses = {
  sm: 'w-3! h-3!',
  md: 'w-4! h-4!',
  lg: 'w-5! h-5!',
}[size];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 289.6 375.2"
  aria-hidden="true"
  focusable="false"
  data-direction={direction}
  data-size={size}
  class:list={[
    'astro-swiper-arrow swiper-navigation-icon block shrink-0 object-contain transition-transform duration-200',
    sizeClasses,
    direction === 'prev'
      ? '[transform:rotate(180deg)] group-hover:-translate-x-0.5'
      : 'group-hover:translate-x-0.5',
    className,
  ]}
  {...props}
>
  <path
    fill="currentColor"
    d="M13.2.6A16 16 0 0 0 3 7.3a17 17 0 0 0-.1 19c1.4 2.1 34.4 39.2 73.2 82.3s70.6 78.7 70.6 79.1-31.8 36-70.6 79.1S4.3 347 2.9 349.1a17 17 0 0 0 0 19c5.8 7.4 2.7 7.1 65.3 7.1 53 0 56.2 0 59-1.9a6723 6723 0 0 0 160.2-177.8q4.3-7.8 0-15.6A7074 7074 0 0 0 128.7 3.2l-4.1-3L70.4 0C40.6 0 14.9.2 13.2.6"
  />
</svg>

<style is:global>
  :where(.astro-swiper-arrow) {
    display: block;
    flex-shrink: 0;
    object-fit: contain;
    fill: currentColor;
    transition: transform 200ms ease;
  }

  :where(.astro-swiper-arrow[data-direction='prev']) {
    transform: rotate(180deg);
  }

  .astro-swiper-arrow[data-size='sm'] {
    width: 0.75rem;
    height: 0.75rem;
  }

  .astro-swiper-arrow[data-size='md'] {
    width: 1rem;
    height: 1rem;
  }

  .astro-swiper-arrow[data-size='lg'] {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
