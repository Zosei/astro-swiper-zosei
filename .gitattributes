# Ensure consistent LF line endings across all platforms.
# Check line endings:
#   git ls-files --eol | grep crlf
# Normalize line endings:
#   git add --renormalize .

* text=auto eol=lf

# Explicit text files always normalized to LF
*.astro text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.jsx text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.sh text eol=lf
*.svg text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitignore text eol=lf
.prettierignore text eol=lf

# Binary assets
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff2 binary
